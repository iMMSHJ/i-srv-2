# ============================================================
# i-srv-2 — Production Deployment Repository
# ============================================================

# Runtime / temporary
/proc/
/sys/
/dev/
/run/
/tmp/
/var/run/
/var/lock/
/var/cache/
/var/log/
/var/tmp/
/lost+found/

# OS / private user data
/root/
/home/*/.ssh/
/home/*/.gnupg/
/home/*/.cache/
/home/*/.npm/
/home/*/.pm2/

# Frontend runtime/build artifacts
/opt/frontend/app/node_modules/
/opt/frontend/app/.next/
/opt/frontend/app/out/
/opt/frontend/app/build/
/opt/frontend/app/coverage/

# Secrets / environment
/opt/frontend/app/.env
/opt/frontend/app/.env.*
!/opt/frontend/app/.env.example

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx

# Logs
*.log

# TypeScript generated files
*.tsbuildinfo

# Package caches
/var/lib/npm/
/var/lib/node_modules/

# System areas — never deployment source
/boot/
/bin/
/sbin/
/lib/
/lib64/
/usr/
/srv/
/snap/
